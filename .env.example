# LLM Configuration (Microsoft Foundry Local - on-device, offline)
# Endpoint is auto-discovered from `foundry service status`; override if needed.
# FOUNDRY_ENDPOINT=http://127.0.0.1:62208/v1
LLM_MODEL=phi-4-mini

# Embedding Configuration (sentence-transformers, runs locally on CPU)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu

# Database Configuration
DATABASE_PATH=./data/rag.db

# Logging
LOG_LEVEL=INFO
